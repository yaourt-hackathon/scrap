# Copier en .env (ignoré par git). Toutes les variables sont optionnelles.

# Dossier de sortie des CSV (défaut : ./sortie). Ex. ../data/data/00_sources
SCRAP_SORTIE=

# Navigateur distant en CDP pour PlaywrightCrawler (BrightData, Krowler…)
SCRAP_CDP_URL=

# Projet Google Cloud qui exécute les requêtes BigQuery (sources *-bigquery)
GCP_PROJET=
